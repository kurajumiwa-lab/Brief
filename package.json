{
  "name": "brief",
  "version": "1.0.0",
  "description": "Brief: An information layer for what is happening around you",
  "private": true,
  "type": "module",
  "workspaces": [
    "preview",
    "server",
    "tc"
  ],
  "scripts": {
    "install:all": "npm install && npm --workspace=preview install && npm --workspace=server install && npm --workspace=tc install",
    "build:client": "npm --workspace=preview run build",
    "build": "npm run build:client",
    "start": "NODE_ENV=production node server/src/index.js",
    "start:dev": "cd server && npm start",
    "dev": "cd preview && npm run dev",
    "test": "cd server && npm test",
    "test:notifications": "node server/test/notifications.mjs",
    "test:yard": "npm --workspace=server run test:yard",
    "test:client": "./run-suites.sh",
    "test:typecheck": "node ./node_modules/typescript/bin/tsc -p tc/tsconfig.json",
    "demo:vault": "node scripts/demo-vault.mjs",
    "seed": "node scripts/seed-demo.mjs",
    "seed:clear": "node scripts/seed-demo.mjs --clear",
    "smoke:seeded": "node scripts/smoke-seeded.mjs",
    "test:requests": "node server/test/requests.mjs",
    "test:requests:ui": "npm run build:client && playwright test",
    "test:supply": "node server/test/supply.mjs",
    "test:supply:ui": "playwright test tests/supply.spec.js",
    "test:matching": "node server/test/matching.mjs",
    "test:matching:ui": "npm run build:client && playwright test tests/matching.spec.js",
    "test:quotes": "node server/test/quotes.mjs",
    "test:quotes:ui": "npm run build:client && playwright test tests/quotes.spec.js",
    "test:work": "node server/test/workOrders.mjs",
    "test:work:ui": "npm run build:client && playwright test tests/workOrders.spec.js",
    "test:workforce": "node server/test/workforce.mjs",
    "test:reviews": "node server/test/productReviews.mjs",
    "test:reviews:ui": "npm run build:client && playwright test tests/product-reviews.spec.js",
    "test:tracking": "node server/test/orderTracking.mjs",
    "test:tracking:ui": "npm run build:client && playwright test tests/order-tracking.spec.js",
    "test:admin": "node server/test/adminMembers.mjs",
    "test:admin:ui": "bash run-suites.sh adminwiring admin membersdesk",
    "test:discovery": "node server/test/businessFeed.mjs",
    "test:discovery:ui": "npm run build:client && playwright test tests/business-feed.spec.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "information",
    "discovery",
    "events",
    "communities"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.40.0",
    "typescript": "^7.0.2"
  }
}
