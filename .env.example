# Copy to .env — docker compose and the backend both read it.

# Postgres (asyncpg for the API; alembic derives the sync URL itself).
# The value below is for a Postgres on your own machine. On a host (Railway / Render / `docker run`)
# use the provider's URL instead: `localhost` inside a container is the container itself, and with no
# DATABASE_URL at all the app falls back to host `db`, which exists only inside docker compose.
# (Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} — and don't import this line via "suggested variables".)
# TLS can be asked for as ?sslmode=require or ?ssl=require; each driver gets its own spelling.
# Percent-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql+asyncpg://brief:brief@localhost:5432/brief_vendors
# Seconds the container entrypoint waits for Postgres before exiting with "database never
# became reachable" (the log above that line says why; README → Troubleshooting). 0 = one attempt.
DB_WAIT_TIMEOUT=60

# Redis for the shared rate limiter. Leave empty to use in-process memory.
REDIS_URL=redis://localhost:6379/0

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
# Login lockout: this many failed attempts per account within the window → 429
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Rate limits, requests per minute per token/IP (Redis-backed when REDIS_URL is set)
RATE_LIMIT_AUTH=20
RATE_LIMIT_API=600

# Dev: create tables at boot. Production: false + `alembic upgrade head`.
AUTO_CREATE_TABLES=true

# Browser origins allowed to call the API cross-origin (comma-separated).
# Not needed when the frontend is served by the API or proxied by Vite/nginx.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# POS bridge scheduler pass interval (seconds) and enabled POS types
POS_SYNC_INTERVAL=300
# Explicit market-operations staff allowlist. Replace with registered vendor handles.
# Roles: admin, clerk, spotter, negotiator. Leave empty to disable the staff desk.
MARKET_OPS_ROLES=
# Cooperative-member votes stay disabled until a registered cooperative/legal basis exists.
GOVERNANCE_COOPERATIVE_ENABLED=false
GOVERNANCE_LEGAL_BASIS=
ALLOWED_POS_SYSTEMS=square,shopify,csv,manual,custom_api

# Where the API looks for the built SPA (single-container deploys)
FRONTEND_DIST=../frontend/dist

# File uploads (spec sheets, images). Leave S3_BUCKET empty to store under
# UPLOAD_DIR and serve at /static; set it for any S3-compatible bucket.
UPLOAD_DIR=./static
MAX_UPLOAD_MB=10
S3_BUCKET=
# Chat voice notes are private (never served from /static); local fallback path
# and per-clip limits. Keep the S3 bucket private so these objects stay private.
VOICE_UPLOAD_DIR=./voice_uploads
VOICE_MAX_BYTES=524288
VOICE_MAX_SECONDS=15
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT=                # e.g. https://<account>.r2.cloudflarestorage.com for R2 / MinIO
S3_PUBLIC_URL=              # CDN / public base URL for the bucket, if not the S3 default
S3_PUBLIC_ACL=false

# Stock engine
STOCK_LOW_THRESHOLD=5       # STOCK_LOW alert at or below this many units
RESERVATION_HOLD_HOURS=72   # unconfirmed sourcing requests lapse after this

# ── v2.2 observability, bookings and routing ─────────────────────────────────
METRICS_ENABLED=true        # false removes the timing middleware and /api/metrics
METRICS_TOKEN=              # set to gate /api/metrics behind ?token= or a bearer token
SLOW_REQUEST_MS=1000        # requests above this are logged and listed by /api/ops/slow
BOOKING_MAX_DAYS=365        # longest window a single tool booking may span
ROUTE_DEFAULT_SPEED_KMH=25  # default speed used for route ETAs

# ── v2.5 PSP payments + digital chamas ───────────────────────────────────────
# Provider: mock (default, in-process test double) or mpesa.
PSP_PROVIDER=mock
# Mock behaviour — flip these without redeploying (ops endpoints read them live):
PSP_MOCK_MODE=normal        # normal | fail_mode | replay
PSP_MOCK_LATENCY_MS=50
PSP_MOCK_FAIL_RATE=0.0
# Replay a captured real-PSP log: JSONL of {"event": {...}, "signature": "..."}
# (or a single JSON event). Lines carry an optional "at" (ISO) or "delay_ms".
PSP_MOCK_REPLAY_FILE=
PSP_MOCK_REPLAY_FROM=
PSP_MOCK_REPLAY_TO=
# Real provider credentials (ignored in mock mode). The webhook secret signs
# HMAC-SHA256 of the raw request body; generate with `openssl rand -hex 32`.
PSP_BASE_URL=
PSP_API_KEY=
PSP_WEBHOOK_SECRET=
PSP_SUB_ACCOUNT_SUFFIX=86   # wallet = "BRIEF_" + last digits of the vendor phone
PSP_REQUEST_TIMEOUT=15
# Ops alert threshold: in-flight PSP amounts older than this (minutes) are
# listed on the custody desk.
PSP_IN_FLIGHT_ALERT_MIN=15
# Chama guardrails (KSh, per member)
CHAMA_DEPOSIT_LIMIT_KSH=50000
CHAMA_LOAN_LIMIT_KSH=100000
CHAMA_DIVIDEND_MIN_POOL_KSH=1000
# Halal pools (v2.6): flat admin fee (KSh) netted from each zero-interest
# loan payout — a disclosed cost recovery (PSP charges), never interest.
CHAMA_QARD_ADMIN_FEE_KSH=50
# Murabaha (cost-plus) advances: grace days after the payment due date
# before the worker marks the contract defaulted (no late interest, ever).
MURABAHA_GRACE_DAYS=3
# Daily Lock settlement fee (clamped 1–5%)
MARKET_LOCK_SETTLE_FEE_PCT=2
MARKET_LOCK_SETTLE_MIN_KSH=200

# ── Map (v2.7) — viewport queries, clustering, tiles ─────────────────────────
# The map never downloads the directory: every screenful is one bbox query that
# returns clusters when zoomed out and a capped list of pins when zoomed in.
MAP_PLACES_POINT_ZOOM=15     # zoom at/above which individual businesses are drawn
MAP_VENDORS_POINT_ZOOM=12    # …individual vendors
MAP_MARKETS_POINT_ZOOM=6     # …individual markets
MAP_POINT_LIMIT=300          # hard ceiling on pins per layer per view
MAP_CLUSTER_CELL_PX=96       # cluster grid cell, in screen pixels (~fewer = finer)
MAP_MAX_BBOX_DEG=40          # refuse absurd viewports (a continent of pins)
MAP_CACHE_TTL_SECONDS=60     # server-side viewport cache (then ETag/304 to the phone)
MAP_HTTP_MAX_AGE_SECONDS=30  # Cache-Control on a viewport response
# Tiles. The public OpenStreetMap tile server below is a DEVELOPMENT default: it
# is community-funded, rate-limited, and its usage policy forbids bulk
# downloading. Point this at a commercial OSM-derived provider (Mapbox, MapTiler,
# Stadia, Thunderforest) or your own tile server before launching, and set
# MAP_TILE_DEV_ONLY=false so /api/ops/status stops warning about it.
MAP_TILE_PROVIDER=openstreetmap
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors (ODbL)
MAP_TILE_SUBDOMAINS=
MAP_TILE_MIN_ZOOM=2
MAP_TILE_MAX_ZOOM=19
MAP_TILE_DEV_ONLY=true

# ── docker-compose.prod.yml only ─────────────────────────────────────────────
# POSTGRES_PASSWORD=                  # db password; DATABASE_URL is composed from it, so avoid "@" and "$"
#                                     # (`openssl rand -hex 24` is safe). The db only reads it when its volume is first created.
# DOMAIN=brief.example.com            # Caddy issues a Let's Encrypt cert; empty → plain :80
# (RUN_SCHEDULER is set to false on the API service there; `python -m app.worker` owns the scheduler)
# POS_DAEMON_CONNECTION=              # `--profile pos`: connection id the daemon pushes ./pos-data/stock.csv to
# POS_DAEMON_EMAIL=                   # vendor login the daemon uses
# POS_DAEMON_PASSWORD=
# POS_DAEMON_INTERVAL=60
