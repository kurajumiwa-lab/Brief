# Production template: set these in your deployment environment.
# /data must be a mounted persistent volume, not just a directory.
PORT=8080
BRIEF_DATA_DIR=/data
# ONLY on a confirmed first install with no primary and no backup; remove after initial boot.
BRIEF_ALLOW_EMPTY_STORE=
# Optional comma-separated cross-origin browser clients (same-origin needs none).
BRIEF_CORS_ORIGINS=
BRIEF_PUBLIC_ORIGIN=
# --- KCB Buni collection (server-side only) ----------------------------------
# Optional: leave credentials empty to run without payments. Start with UAT.
# Configure through the deployment secret manager; never paste keys into chat.
BUNI_ENV=uat
BUNI_CONSUMER_KEY=
BUNI_CONSUMER_SECRET=
# Generate locally: openssl rand -hex 24. Callback path:
# <BRIEF_PUBLIC_ORIGIN>/api/webhooks/buni/<secret> (HTTPS origin required).
BUNI_WEBHOOK_SECRET=
# UAT defaults to 522522 if empty. For production use KCB-issued values.
BUNI_ORG_SHORT_CODE=
BUNI_ORG_PASS_KEY=
BUNI_TILL_NO=
# UAT host defaults in code. For production set the host confirmed by KCB;
# do not guess a host or enable the unverified-transfer switch.
BUNI_BASE_URL=
# Money-out remains manual + finance-confirmed. No automated payout is built.
SETTLEMENT_RAIL=manual
HANDOFF_SECRET=
# Email login is disabled until ALL of these are configured and the sender
# domain is verified with Resend. Sign-in proofs are emailed to their owner;
# the API never returns the secret. Legacy BRIEF_LINK_SECRET is ignored.
RESEND_API_KEY=
BRIEF_EMAIL_FROM=
# Google Sign-In. Without it /api/auth/google returns 503 with a stated reason
# rather than faking a session. The client build needs the SAME id as
# VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Image uploads. Files are stored on this machine's disk -- point this at a
# mounted volume if they must survive a redeploy. Defaults to <data dir>/uploads.
BRIEF_UPLOAD_DIR=
# Per-image cap, in bytes (default 8 MB).
BRIEF_UPLOAD_MAX_BYTES=

# Platform administration. Register and verify YOUR account first; then list
# its exact handle (no @), comma-separated. Empty = no bootstrap admins.
# Never give the admin role to every new registration or enable dev auth in prod.
BRIEF_ADMINS=
# Optional lesser-scoped operational accounts (not access to the user directory).
BRIEF_OPERATORS=
BRIEF_REVIEWERS=
BRIEF_FINANCE=
