# Copy to .env — docker compose and the backend both read it.

# Postgres (asyncpg for the API; alembic derives the sync URL itself)
DATABASE_URL=postgresql+asyncpg://brief:brief@localhost:5432/brief_vendors

# Redis for the shared rate limiter. Leave empty to use in-process memory.
REDIS_URL=redis://localhost:6379/0

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
# Login lockout: this many failed attempts per account within the window → 429
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Rate limits, requests per minute per token/IP (Redis-backed when REDIS_URL is set)
RATE_LIMIT_AUTH=20
RATE_LIMIT_API=600

# Dev: create tables at boot. Production: false + `alembic upgrade head`.
AUTO_CREATE_TABLES=true

# Browser origins allowed to call the API cross-origin (comma-separated).
# Not needed when the frontend is served by the API or proxied by Vite/nginx.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# POS bridge scheduler pass interval (seconds) and enabled POS types
POS_SYNC_INTERVAL=300
ALLOWED_POS_SYSTEMS=square,shopify,csv,manual,custom_api

# Where the API looks for the built SPA (single-container deploys)
FRONTEND_DIST=../frontend/dist

# File uploads (spec sheets, images). Leave S3_BUCKET empty to store under
# UPLOAD_DIR and serve at /static; set it for any S3-compatible bucket.
UPLOAD_DIR=./static
MAX_UPLOAD_MB=10
S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT=                # e.g. https://<account>.r2.cloudflarestorage.com for R2 / MinIO
S3_PUBLIC_URL=              # CDN / public base URL for the bucket, if not the S3 default
S3_PUBLIC_ACL=false

# Stock engine
STOCK_LOW_THRESHOLD=5       # STOCK_LOW alert at or below this many units
RESERVATION_HOLD_HOURS=72   # unconfirmed sourcing requests lapse after this

# ── docker-compose.prod.yml only ─────────────────────────────────────────────
# POSTGRES_PASSWORD=                  # db password; DATABASE_URL is composed from it
# DOMAIN=brief.example.com            # Caddy issues a Let's Encrypt cert; empty → plain :80
# (RUN_SCHEDULER is set to false on the API service there; `python -m app.worker` owns the scheduler)
# POS_DAEMON_CONNECTION=              # `--profile pos`: connection id the daemon pushes ./pos-data/stock.csv to
# POS_DAEMON_EMAIL=                   # vendor login the daemon uses
# POS_DAEMON_PASSWORD=
# POS_DAEMON_INTERVAL=60
